<Window x:Class="KanPan.App.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑持仓 - KanPan" Width="720" Height="600" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="每行一只持仓：证券代码, 持仓股数[, 成本价]" FontWeight="SemiBold" />
            <TextBlock Foreground="#6B7280" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="支持逗号、空格、Tab 分隔，可直接从 Excel 复制粘贴。A 股和 ETF 填 6 位代码，自动识别沪/深/北交所；港股填 5 位代码（如 00700），成本价按港元填。成本价可不填，填了才会计算持仓盈亏。" />
        </StackPanel>

        <TextBox x:Name="InputBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="14" Padding="4"
                 TextChanged="OnInputChanged" />

        <DockPanel Grid.Row="2" Margin="0,8">
            <Button DockPanel.Dock="Left" Content="从文件读取…" Click="OnOpenFileClick" />
            <Button DockPanel.Dock="Left" x:Name="PreviewButton" Content="解析预览" Click="OnPreviewClick" Margin="8,0,0,0" />
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#374151" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <DataGrid x:Name="PreviewGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E5E7EB" BorderBrush="#D1D5DB" RowHeight="26">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="#FEE2E2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                            <Setter Property="Background" Value="#FEF3C7" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="行" Binding="{Binding Line}" Width="40" />
                <DataGridTextColumn Header="代码" Binding="{Binding Symbol}" Width="90" />
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="140" />
                <DataGridTextColumn Header="股数" Binding="{Binding Shares}" Width="80" />
                <DataGridTextColumn Header="成本价" Binding="{Binding Cost}" Width="80" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <StackPanel x:Name="ModePanel" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="ReplaceMode" Content="覆盖现有持仓" IsChecked="True" Margin="0,0,16,0" />
                <RadioButton x:Name="MergeMode" Content="合并（相同代码以本次为准）" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="取消" IsCancel="True" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="保存" IsDefault="True" Click="OnSaveClick" />
        </DockPanel>
    </Grid>
</Window>
