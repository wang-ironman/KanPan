<Window x:Class="KanPan.App.Views.TradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="记一笔交易 - KanPan" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="方向" Style="{StaticResource Label}" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="BuyOption" Content="买入 / 建仓" IsChecked="True" Margin="0,0,24,0" Checked="OnInputChanged" />
                <RadioButton x:Name="SellOption" Content="卖出" Checked="OnInputChanged" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="股票" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,12,0" />
            <StackPanel Grid.Row="1" Grid.Column="1">
                <ComboBox x:Name="StockBox" IsEditable="True" IsTextSearchEnabled="False" Height="28"
                          SelectionChanged="OnStockSelectionChanged" />
                <TextBlock x:Name="StockInfo" Style="{StaticResource Hint}" Margin="0,4,0,6"
                           Text="从下拉列表选择已有持仓，或直接输入代码建仓" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="成交价" Style="{StaticResource Label}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="PriceBox" Width="140" TextChanged="OnInputChanged" />
                <TextBlock x:Name="PriceUnit" Text="元" Style="{StaticResource Hint}" />
                <Button x:Name="UseQuoteButton" Content="用现价" Margin="12,0,0,0" MinWidth="0" Padding="10,3" Click="OnUseQuoteClick" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="数量" Style="{StaticResource Label}" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="QuantityBox" Width="140" TextChanged="OnInputChanged" />
                <TextBlock Text="股" Style="{StaticResource Hint}" />
                <Button x:Name="SellAllButton" Content="全部卖出" Margin="12,0,0,0" MinWidth="0" Padding="10,3" Click="OnSellAllClick" />
            </StackPanel>

            <TextBlock Grid.Row="4" Text="手续费" Style="{StaticResource Label}" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="FeeBox" Width="140" TextChanged="OnInputChanged" />
                <TextBlock x:Name="FeeUnit" Text="元，含佣金和印花税，可不填" Style="{StaticResource Hint}" />
            </StackPanel>

            <TextBlock x:Name="MethodLabel" Grid.Row="5" Text="成本算法" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,8,12,0" />
            <StackPanel x:Name="MethodPanel" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="DilutedOption" Content="摊薄成本" IsChecked="True" Margin="0,0,24,0" Checked="OnInputChanged" />
                    <RadioButton x:Name="AverageOption" Content="加权平均" Checked="OnInputChanged" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="摊薄：卖出收回的钱抵减成本，卖赚了成本价会下降（多数券商默认）。加权平均：卖出只减股数，成本价不变。" />
            </StackPanel>
        </Grid>

        <Border Margin="0,14,0,0" Padding="12,10" Background="#F3F4F6" CornerRadius="4">
            <StackPanel>
                <TextBlock x:Name="BeforeText" Foreground="#374151" />
                <TextBlock x:Name="AfterText" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="WarningText" Foreground="#B45309" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="保存" IsDefault="True" IsEnabled="False" Click="OnSaveClick" />
            <Button Content="取消" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
